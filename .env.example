# このファイルはコミットする。実際の値は .env.local に書くこと（.gitignore 済み）。
# ここに service_role キーを書かないこと。フロントエンドに置いた時点で全世界に公開される。

# 'development' | 'production'
# Supabase の auth.storageKey の接尾辞に使う（本番/検証のセッション衝突を防ぐため）
VITE_APP_ENV=development

# ローカル開発では検証用 Supabase プロジェクト、または `supabase start` の値を使う
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Vite の base。ローカルは / のまま。本番/検証の値は deploy.yml が与える。
VITE_BASE_PATH=/
